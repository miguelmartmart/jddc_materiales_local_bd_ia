# ============================================================
# .env.example — Plantilla de configuracion DEVIA / interjddcia
# 1. Copiar este archivo: copy .env.example .env
# 2. Editar .env con los valores reales de tu entorno
# 3. NUNCA subir .env a Git (ya esta en .gitignore)
# ============================================================

# ── Entorno ──────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=False
PORT=8001

# ── Base de datos Firebird / SQL Obras ───────────────────────
# IP del servidor Firebird en la red local (ejemplo: 192.168.0.10)
DB_HOST=192.168.0.X
DB_PORT=3050
# Ruta COMPLETA a la base de datos TAL COMO LA VE EL SERVIDOR (no el cliente)
# Ejemplo Windows: C:\Bases\EMPRESA.FDB
# Ejemplo Linux:   /var/lib/firebird/data/empresa.fdb
DB_NAME=C:\ruta\completa\en\servidor\empresa.fdb
DB_USER=SYSDBA
DB_PASSWORD=masterkey

# ── IA Local JDDC (Qwen3 30B en la red LAN) ──────────────────
# Dejar los valores por defecto si el servidor IA esta en la misma red
JDDCIA_API_KEY=YWRtaW46YWlzdGFjazIwMjY=
JDDCIA_BASE_URL=http://jddcia.local/api/vlm/v1
JDDCIA_BASE_URL_FALLBACK=http://192.168.0.36/api/vlm/v1

# ── APIs de IA externas (solo rellenar las que se usen) ───────
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_CLAUDE_API_KEY=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=

# ── API Explorer Distrito K / SQL Obras (modulo API Explorer) ─
# SQLOB_USE_MOCK=true → usa datos de ejemplo, sin conexion real
# SQLOB_USE_MOCK=false → conecta con la API real de Distrito K
SQLOB_API_URL=https://erp.tuempresa.com/api
SQLOB_EMPRESA=JDDC
SQLOB_USUARIO=API_JDDC
SQLOB_PASSWORD=
SQLOB_TIMEOUT=30
SQLOB_VERIFY_SSL=true
SQLOB_USE_MOCK=true

# ── Email / Outlook (opcional) ────────────────────────────────
OUTLOOK_EMAIL=tu_email@outlook.es
OUTLOOK_PASSWORD=
GMAIL_EMAIL=
GMAIL_PASSWORD=
